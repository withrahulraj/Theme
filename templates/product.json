{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "stock_status": {
          "type": "stock_status",
          "settings": {
            "in_stock_text": "In stock and ready to ship",
            "low_stock_text": "Almost sold out",
            "out_of_stock_text": "Sold out"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "square"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "shipping_row": {
          "type": "shipping_row",
          "settings": {
            "ships_prefix": "Ships by"
          }
        },
        "payment_icons": {
          "type": "payment_icons"
        },
        "assurance": {
          "type": "assurance"
        },
        "description": {
          "type": "description"
        },
        "usp_list": {
          "type": "usp_list",
          "settings": {
            "icon": "check",
            "items": "Free shipping, delivered in [[delivery_min]]–[[delivery_max]] business days\n[[returns_days]]-day returns with free return shipping\nSecure encrypted checkout"
          }
        },
        "tab_returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "30-Day Returns",
            "icon": "return",
            "content": "<p>Not the right light for the room? Send it back within [[returns_days]] days of delivery for a full refund. The lamp needs to be in its original packaging and in resaleable condition.</p><p><strong>Return shipping is free</strong> and there are no restocking fees. Email [[email_link]] to start a return and we will send a prepaid label and instructions the same working day.</p><p>Full terms are in our <a href=\"[[refund_policy_url]]\">Return and Refund Policy</a>.</p>"
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Free Shipping",
            "icon": "truck",
            "content": "<p><strong>Free shipping on every order</strong>, with no minimum spend and tracking included.</p><ul><li>Processing: [[handling_min]]–[[handling_max]] business days</li><li>Transit: [[transit_min]]–[[transit_max]] business days</li><li><strong>Delivery estimate: [[delivery_min]]–[[delivery_max]] business days</strong></li></ul><p>We ship to [[shipping_countries]]. You get a tracking number by email the moment your order leaves us, and you can follow it on our <a href=\"[[track_url]]\">Track Your Order</a> page.</p><p>Full details are in our <a href=\"[[shipping_policy_url]]\">Shipping Policy</a>.</p>"
          }
        },
        "tab_payments": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Secure Payments",
            "icon": "lock",
            "content": "<p>Every payment runs through Shopify's encrypted checkout. Your card details are never stored on our servers and are never visible to us.</p><p>Pay with any major card, or with Apple Pay, Google Pay, Shop Pay or PayPal — whichever methods are live on this store are shown at checkout.</p><p>Questions about a charge? Email [[email_link]], [[hours_days]], [[hours_time]].</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "stock_status",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "shipping_row",
        "payment_icons",
        "assurance",
        "description",
        "usp_list",
        "tab_returns",
        "tab_shipping",
        "tab_payments",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "columns",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust_strip": {
      "type": "trust-strip",
      "blocks": {
        "shipping": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free shipping",
            "text": "On every order, tracking included."
          }
        },
        "returns": {
          "type": "item",
          "settings": {
            "icon": "refresh",
            "title": "30-day returns",
            "text": "Not the right glow? Send it back."
          }
        },
        "secure": {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "Secure checkout",
            "text": "Encrypted payments, every time."
          }
        },
        "support": {
          "type": "item",
          "settings": {
            "icon": "headset",
            "title": "Real support",
            "text": "Mon–Fri, answered within 24 hours."
          }
        }
      },
      "block_order": [
        "shipping",
        "returns",
        "secure",
        "support"
      ],
      "settings": {
        "heading": "",
        "layout": "stacked",
        "show_payment_icons": false,
        "color_scheme": "scheme-2",
        "padding_top": 40,
        "padding_bottom": 40
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Pairs well with",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "trust_strip",
    "disclosures",
    "related-products"
  ]
}
