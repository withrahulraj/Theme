{% doc %}
  Renders the star rating line for a product. Real review data is used whenever a
  reviews app has written the standard `reviews.rating` metafields; the theme
  settings are the fallback so the line never renders empty on a new store.

  @param {object} product - The product to read review metafields from.
  @param {string} [rating_text] - Template for the text beside the stars. Use {{ rating }}, {{ scale }} and {{ count }}.

  @example
  {% render 'product-rating-line', product: product %}
{% enddoc %}

{%- liquid
  assign rating_value = 0
  assign rating_scale = 5
  assign rating_count = ''
  assign has_real_reviews = false

  if product.metafields.reviews.rating.value != blank
    assign rating_value = product.metafields.reviews.rating.value.rating | plus: 0.0
    assign rating_scale = product.metafields.reviews.rating.value.scale_max | plus: 0
    assign has_real_reviews = true
  endif

  if product.metafields.reviews.rating_count != blank
    assign rating_count = product.metafields.reviews.rating_count.value | plus: 0
  endif

  unless has_real_reviews
    assign rating_value = settings.product_rating_value | plus: 0.0
    assign rating_scale = 5
  endunless

  if rating_count == blank or rating_count == 0
    assign rating_count = settings.product_rating_count
  endif

  if rating_scale < 1
    assign rating_scale = 5
  endif

  assign full_stars = rating_value | floor
  assign remainder = rating_value | minus: full_stars
  assign has_half = false
  if remainder >= 0.3
    assign has_half = true
  endif
  assign empty_stars = rating_scale | minus: full_stars
  if has_half
    assign empty_stars = empty_stars | minus: 1
  endif

  assign rating_display = rating_value | round: 1
-%}

{%- if settings.product_show_rating and rating_value > 0 -%}
  <div class="product__rating-line">
    <span class="rating-stars" role="img" aria-label="{{ rating_display }} out of {{ rating_scale }} stars">
      {%- if full_stars > 0 -%}
        {%- for i in (1..full_stars) -%}
          {%- render 'universal-icon', icon: 'star' -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if has_half -%}
        {%- render 'universal-icon', icon: 'star_half' -%}
      {%- endif -%}
      {%- if empty_stars > 0 -%}
        {%- for i in (1..empty_stars) -%}
          {%- render 'universal-icon', icon: 'star_empty' -%}
        {%- endfor -%}
      {%- endif -%}
    </span>
    <span class="product__rating-text">{{ rating_display }} / {{ rating_scale }}</span>
    {%- if rating_count != blank -%}
      <span class="product__rating-count">{{ rating_text | default: 'Rated' }} ({{ rating_count }} Reviews)</span>
    {%- endif -%}
  </div>
{%- endif -%}
