{% doc %}
  Renders the store's trading details in the same shape as the footer's store
  column — the store name, then icon rows for address, phone, email and hours.

  Every value comes from Settings → Store details (or the theme's Store
  information overrides), so a policy page carries correct trading details
  without anyone retyping them, and one change in admin updates every page.

  Rows with no value behind them are skipped rather than printed empty.

  @param {string} [heading] - Block heading. Pass blank to omit it.
  @param {string} [note] - Optional small print under the rows.

  @example
  {% render 'store-details-block', heading: 'Store information' %}
{% enddoc %}

{%- liquid
  assign detail_name = settings.store_name_override | default: shop.name

  capture detail_address
    render 'store-info', field: 'address'
  endcapture
  assign detail_address = detail_address | strip

  capture detail_phone
    render 'store-info', field: 'phone'
  endcapture
  assign detail_phone = detail_phone | strip

  capture detail_phone_href
    render 'store-info', field: 'phone_href'
  endcapture
  assign detail_phone_href = detail_phone_href | strip

  capture detail_email
    render 'store-info', field: 'email'
  endcapture
  assign detail_email = detail_email | strip

  capture detail_hours
    render 'store-info', field: 'hours_time'
  endcapture
  assign detail_hours = detail_hours | strip
-%}

<div class="store-details">
  {%- if heading != blank -%}
    <h2 class="store-details__heading">{{ heading | escape }}</h2>
  {%- endif -%}

  {%- if detail_name != blank -%}
    <p class="store-details__name">{{ detail_name }}</p>
  {%- endif -%}

  <ul class="store-details__list list-unstyled" role="list">
    {%- if detail_address != blank -%}
      <li class="store-details__row">
        <span class="store-details__icon" aria-hidden="true">{%- render 'universal-icon', icon: 'pin' -%}</span>
        <span class="store-details__value">
          <span class="visually-hidden">{{ 'universal.store_details.address' | t }}: </span>
          {{- detail_address | newline_to_br -}}
        </span>
      </li>
    {%- endif -%}

    {%- if detail_phone != blank -%}
      <li class="store-details__row">
        <span class="store-details__icon" aria-hidden="true">{%- render 'universal-icon', icon: 'phone' -%}</span>
        <span class="store-details__value">
          <span class="visually-hidden">{{ 'universal.store_details.phone' | t }}: </span>
          <a href="tel:{{ detail_phone_href }}">{{ detail_phone }}</a>
        </span>
      </li>
    {%- endif -%}

    {%- if detail_email != blank -%}
      <li class="store-details__row">
        <span class="store-details__icon" aria-hidden="true">{%- render 'universal-icon', icon: 'mail' -%}</span>
        <span class="store-details__value">
          <span class="visually-hidden">{{ 'universal.store_details.email' | t }}: </span>
          <a href="mailto:{{ detail_email }}">{{ detail_email }}</a>
        </span>
      </li>
    {%- endif -%}

    {%- if settings.store_hours_days != blank or detail_hours != blank -%}
      <li class="store-details__row">
        <span class="store-details__icon" aria-hidden="true">{%- render 'universal-icon', icon: 'clock' -%}</span>
        <span class="store-details__value">
          <span class="visually-hidden">{{ 'universal.store_details.hours' | t }}: </span>
          {%- if settings.store_hours_days != blank -%}
            <span class="store-details__strong">{{ settings.store_hours_days }}</span>
          {%- endif -%}
          {%- if detail_hours != blank -%}
            <br>{{ detail_hours }}
          {%- endif -%}
        </span>
      </li>
    {%- endif -%}
  </ul>

  {%- if note != blank -%}
    <p class="store-details__note">{{ note | escape }}</p>
  {%- endif -%}
</div>
