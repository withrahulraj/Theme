{% comment %}
  Product markup for Google Merchant Center, free listings and rich results.

  Replaces Shopify's `structured_data` filter, which cannot carry the
  shipping, returns and identifier fields Merchant Center reads. One Offer is
  emitted per variant so Google can match each variant URL to a feed item.

  Ratings are published only when a reviews app has written real values to the
  product's `reviews` metafields — the placeholder rating used for display is
  never marked up.

  Usage:
  {% render 'structured-data-product', product: product %}
{% endcomment %}

{%- liquid
  assign sd_currency = cart.currency.iso_code | default: shop.currency
  assign sd_condition = settings.sd_condition | default: 'NewCondition'
  assign sd_brand = product.vendor | default: settings.sd_brand_fallback | default: shop.name
  assign sd_description = product.description | strip_html | strip_newlines | truncate: 5000
  if sd_description == blank
    assign sd_description = product.title
  endif

  assign sd_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'

  assign sd_rating = product.metafields.reviews.rating.value.rating
  assign sd_rating_scale = product.metafields.reviews.rating.value.scale_max | default: 5
  assign sd_rating_count = product.metafields.reviews.rating_count.value | plus: 0
  assign sd_has_rating = false
  if settings.sd_ratings_enabled and sd_rating != blank and sd_rating_count > 0
    assign sd_has_rating = true
  endif
-%}

{%- comment -%} Shipping and returns are Offer-level, so build them once. {%- endcomment -%}
{%- capture sd_shipping_details -%}
  {%- if settings.sd_shipping_enabled -%}
    {%- assign sd_countries = settings.sd_shipping_countries | split: ',' -%}
    ,"shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": {{ settings.sd_shipping_rate | default: 0 | plus: 0.0 | round: 2 }},
        "currency": {{ sd_currency | json }}
      },
      "shippingDestination": [
        {%- for sd_country in sd_countries -%}
          {
            "@type": "DefinedRegion",
            "addressCountry": {{ sd_country | strip | upcase | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": {{ settings.sd_handling_min | default: 1 }},
          "maxValue": {{ settings.sd_handling_max | default: 2 }},
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": {{ settings.sd_transit_min | default: 5 }},
          "maxValue": {{ settings.sd_transit_max | default: 9 }},
          "unitCode": "DAY"
        },
        "businessDays": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "https://schema.org/Monday",
            "https://schema.org/Tuesday",
            "https://schema.org/Wednesday",
            "https://schema.org/Thursday",
            "https://schema.org/Friday"
          ]
        }
        {%- if settings.sd_cutoff_time != blank -%}
          ,"cutoffTime": {{ settings.sd_cutoff_time | json }}
        {%- endif -%}
      }
    }
  {%- endif -%}
{%- endcapture -%}

{%- capture sd_return_policy -%}
  {%- if settings.sd_returns_enabled -%}
    {%- assign sd_return_countries = settings.sd_shipping_countries | split: ',' -%}
    ,"hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": [
        {%- for sd_country in sd_return_countries -%}
          {{ sd_country | strip | upcase | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "returnPolicyCountry": [
        {%- for sd_country in sd_return_countries -%}
          {{ sd_country | strip | upcase | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": {{ settings.trust_returns_days | default: 30 }},
      "refundType": "https://schema.org/FullRefund",
      "returnMethod": "https://schema.org/{{ settings.sd_return_method | default: 'ReturnByMail' }}",
      "returnFees": "https://schema.org/{{ settings.sd_return_fees | default: 'FreeReturn' }}"
      {%- if settings.sd_return_fees == 'ReturnShippingFees' -%}
        ,"returnShippingFeesAmount": {
          "@type": "MonetaryAmount",
          "value": {{ settings.sd_return_fee_amount | default: 0 | plus: 0.0 | round: 2 }},
          "currency": {{ sd_currency | json }}
        }
      {%- endif -%}
    }
  {%- endif -%}
{%- endcapture -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": {{ request.origin | append: product.url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "description": {{ sd_description | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.images.size > 0 %}
    "image": [
      {%- for sd_image in product.images limit: 10 -%}
        {{ sd_image | image_url: width: 1920 | prepend: 'https:' | json }}
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
  {%- endif %}
  "brand": {
    "@type": "Brand",
    "name": {{ sd_brand | json }}
  },
  {%- if product.type != blank %}
    "category": {{ product.type | json }},
  {%- endif %}
  {%- if sd_has_rating %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ sd_rating | json }},
      "bestRating": {{ sd_rating_scale | json }},
      "ratingCount": {{ sd_rating_count | json }}
    },
  {%- endif %}
  "offers": [
    {%- for sd_variant in product.variants -%}
      {%- liquid
        assign sd_barcode = sd_variant.barcode | strip
        assign sd_barcode_size = sd_barcode | size
        assign sd_gtin = ''

        if sd_barcode_size == 8 or sd_barcode_size == 12 or sd_barcode_size == 13 or sd_barcode_size == 14
          assign sd_barcode_digits = sd_barcode | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4'
          assign sd_barcode_digits = sd_barcode_digits | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
          if sd_barcode_digits == blank
            assign sd_gtin = sd_barcode
          endif
        endif

        assign sd_mpn = sd_variant.metafields.custom.mpn | default: product.metafields.custom.mpn

        capture sd_sku
          render 'variant-sku', variant: sd_variant, product: product
        endcapture
        assign sd_sku = sd_sku | strip

        if sd_variant.available
          assign sd_availability = 'InStock'
        else
          assign sd_availability = 'OutOfStock'
        endif
      -%}
      {
        "@type": "Offer",
        "@id": {{ request.origin | append: sd_variant.url | json }},
        "url": {{ request.origin | append: sd_variant.url | json }},
        "price": {{ sd_variant.price | divided_by: 100.0 | round: 2 }},
        "priceCurrency": {{ sd_currency | json }},
        "priceValidUntil": {{ sd_valid_until | json }},
        "availability": "https://schema.org/{{ sd_availability }}",
        "itemCondition": "https://schema.org/{{ sd_condition }}",
        {%- if sd_sku != blank %}
          "sku": {{ sd_sku | json }},
        {%- endif %}
        {%- if sd_gtin != blank %}
          "gtin": {{ sd_gtin | json }},
        {%- endif %}
        {%- if sd_mpn != blank %}
          "mpn": {{ sd_mpn | json }},
        {%- endif %}
        {%- if sd_variant.featured_image %}
          "image": {{ sd_variant.featured_image | image_url: width: 1920 | prepend: 'https:' | json }},
        {%- endif %}
        "seller": {
          "@type": "Organization",
          "@id": {{ request.origin | append: '/#organization' | json }},
          "name": {{ shop.name | json }}
        }
        {{- sd_shipping_details -}}
        {{- sd_return_policy -}}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
