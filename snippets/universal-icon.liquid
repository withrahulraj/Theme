{% doc %}
  Renders one of the theme's inline UI icons. Stroke-based so they inherit the
  current text color in every color scheme.

  @param {string} icon - pin, phone, mail, clock, truck, box, shield, refresh, star, star_half, star_empty, check, search, spark, leaf, bulb, headset.
  @param {string} [size] - Pixel size. Defaults to 20.

  @example
  {% render 'universal-icon', icon: 'truck', size: 24 %}
{% enddoc %}
{%- assign icon_size = size | default: 20 -%}
<svg
  class="universal-icon universal-icon--{{ icon }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'pin' -%}
      <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>
    {%- when 'phone' -%}
      <path d="M5 4h3.2l1.6 4-2 1.4a11.5 11.5 0 0 0 5.4 5.4l1.4-2 4 1.6V18a2 2 0 0 1-2.2 2A15.8 15.8 0 0 1 3 6.2 2 2 0 0 1 5 4Z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.6 7 7.3 5.2a2 2 0 0 0 2.2 0L20.4 7"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.2V12l3.2 2"/>
    {%- when 'truck' -%}
      <path d="M2.5 7.5A1.5 1.5 0 0 1 4 6h9.5v9H4a1.5 1.5 0 0 1-1.5-1.5v-6Z"/><path d="M13.5 9H17l3 3v3h-6.5"/><circle cx="7" cy="17" r="1.9"/><circle cx="17" cy="17" r="1.9"/>
    {%- when 'box' -%}
      <path d="m12 2.8 8 4.1v10.2l-8 4.1-8-4.1V6.9l8-4.1Z"/><path d="m4 6.9 8 4.1 8-4.1M12 11v10.2"/>
    {%- when 'shield' -%}
      <path d="M12 2.8 19.2 6v5.5c0 4.4-3 8-7.2 9.7-4.2-1.7-7.2-5.3-7.2-9.7V6L12 2.8Z"/><path d="m8.8 11.8 2.2 2.2 4.2-4.4"/>
    {%- when 'refresh' -%}
      <path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4.4h-4.4"/>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.3-4.3"/>
    {%- when 'spark' -%}
      <path d="M12 3.2 13.9 9l5.9 1.9-5.9 1.9L12 20.8 10.1 12.8 4.2 10.9 10.1 9 12 3.2Z"/>
    {%- when 'leaf' -%}
      <path d="M20 4c0 8.5-4.6 13-11.4 13H5c0-8 5-13 15-13Z"/><path d="M5 20c1.6-4.6 4.3-7.7 8.4-9.6"/>
    {%- when 'bulb' -%}
      <path d="M9.4 17.5a6 6 0 1 1 5.2 0"/><path d="M9.8 17.5h4.4M10.4 20.4h3.2"/>
    {%- when 'headset' -%}
      <path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2"/><rect x="2.8" y="13.4" width="3.6" height="5.2" rx="1.8"/><rect x="17.6" y="13.4" width="3.6" height="5.2" rx="1.8"/><path d="M19.5 18.6v.6a2.4 2.4 0 0 1-2.4 2.4H13"/>
    {%- when 'star' -%}
      <path d="m12 3.6 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.8l5.9-.9L12 3.6Z" fill="currentColor" stroke="none"/>
    {%- when 'star_half' -%}
      <defs>
        <linearGradient id="universal-star-half">
          <stop offset="50%" stop-color="currentColor"/>
          <stop offset="50%" stop-color="transparent"/>
        </linearGradient>
      </defs>
      <path d="m12 3.6 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.8l5.9-.9L12 3.6Z" fill="url(#universal-star-half)" stroke="currentColor" stroke-width="1.2"/>
    {%- when 'star_empty' -%}
      <path d="m12 3.6 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.8l5.9-.9L12 3.6Z" stroke-width="1.2"/>
  {%- endcase -%}
</svg>
